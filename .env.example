# 环境变量示例：复制为 .env 后按需修改
#
# 微信开发者工具 / H5 联调默认读取 .env（所有模式生效）。
# 分模式覆盖请用 .env.development（npm run dev:*）、.env.production（npm run build:*）

# 后端 API 基础地址。Node 后端就绪后填写，例如：https://api.example.com
# 留空 = 前端全部走本地 mock，页面代码无需任何改动即可联调。
VITE_API_BASE_URL=

# 是否强制使用本地 mock：'true' | 'false'
# - 未配置时：dev 环境自动开启；生产构建默认关闭
# - 显式 'true'：任何环境都走 mock（当前阶段建议保持 true）
VITE_USE_MOCK=true
